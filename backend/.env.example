# Supabase & Notifications configuration
SUPABASE_URL=https://pfemdshixllwqqajsxxp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_KEY=your_supabase_anon_key

# Email backend used by notification-worker (worker will POST to $EMAIL_BACKEND_URL/send)
# default (local email backend): http://localhost:4000
EMAIL_BACKEND_URL=http://localhost:4000
EMAIL_SERVICE_URL=http://localhost:4000

# Optional: secret required by /api/notifications/create if you enable it
NOTIFICATIONS_SECRET=

# Notification worker tuning (defaults used by worker if not set)
# Poll interval in milliseconds
NOTIFICATION_WORKER_POLL_MS=8000
# Batch size: how many notifications to fetch/send per loop (set to 300 by default)
NOTIFICATION_WORKER_BATCH=300



