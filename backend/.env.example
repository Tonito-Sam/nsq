# Copy this to .env and fill the values
# Production: keep your REPLICATE_API_TOKEN secret and do NOT commit .env to version control

# If you have a self-hosted Automatic1111 web UI, set it here (optional):
# AUTOMATIC1111_URL=http://127.0.0.1:7860

# Replicate (server-side)
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=29dd0e7c5f8d1bdf6d1362efc497bb7d6199b6d7c3979d735a1d27d1fe865ec8
REPLICATE_MODEL_VERSION_FALLBACK_1=4f7bd6be168f8f184d210b897faef6b0de23acb8e1cd6d94dd1cddb078fcbe37
